# Copy to .env.local and fill in. Never commit real values (.env* is gitignored).
# All variables are consumed server-side only. Phase 1 needs none of them.

# --- Gemini (Phase 3): the evaluator's single bounded call ---
# API key for @google/genai.
GEMINI_API_KEY=
# Model id, kept configurable (e.g. gemini-2.5-flash). Confirm availability + structured output in Phase 3.
GEMINI_MODEL=

# --- Database (Phase 3): core storage on every request ---
# PostgreSQL connection string (Tiger Data or other managed Postgres), e.g.
# postgres://user:pass@host:5432/inverse_tutor?sslmode=require
DATABASE_URL=

# --- ElevenLabs (Phase 5): speaks approved learner text only ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Debugging (optional) ---
# When "true", raw evaluator responses are retained (separate table, with expiry). Off by default.
DEBUG_LLM_PAYLOADS=
