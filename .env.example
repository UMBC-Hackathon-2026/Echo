# Copy to .env.local and fill in. Never commit real values (.env* is gitignored,
# except this template). All variables are consumed server-side only.

# --- Gemini (Phase 3): the evaluator's single bounded call ---
GEMINI_API_KEY=
# Model id, e.g. gemini-2.5-flash. May be blank until Phase 3 picks one.
GEMINI_MODEL=

# --- Database (Phase 3): core storage on every request ---
# Tiger Cloud free service (one database named tsdb, no pooler -> direct connection).
# Format: postgresql://USER:PASSWORD@HOST:PORT/tsdb?sslmode=require
DATABASE_URL=
# A SEPARATE database/host used by db:reset:test and the DB tests (it gets reset).
DATABASE_URL_TEST=

# --- ElevenLabs (Phase 5): speaks approved learner text only ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Debugging (optional) ---
# When "true", raw evaluator responses are retained (separate table, with expiry).
DEBUG_LLM_PAYLOADS=
