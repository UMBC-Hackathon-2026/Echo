{
  "name": "inverse-tutor-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:content": "node --conditions=react-server --import tsx scripts/check-content.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:prod-guard": "tsx scripts/check-production-guard.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:reset:test": "tsx scripts/db-reset-test.ts",
    "eval:live": "node --conditions=react-server --import tsx scripts/eval-live.ts",
    "smoke:service": "node --conditions=react-server --import tsx scripts/smoke-service.ts",
    "smoke:http": "node --conditions=react-server --import tsx scripts/smoke-http.ts",
    "cleanup:debug": "tsx scripts/cleanup-debug.ts",
    "e2e:scripted": "cross-env E2E_EVALUATOR=scripted NEXT_PUBLIC_DEMO_HELPER=true playwright test",
    "e2e:live": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run check:content && npm run check:secrets && npm run build && npm run check:bundle && npm run check:prod-guard"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.69.0",
    "@google/genai": "^2.24.0",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
